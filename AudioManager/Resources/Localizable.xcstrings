    "Focus mode is on. Only allowed apps can make sound.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak modu açık. Yalnızca izin verilen uygulamalar ses çıkarabilir."
          }
        }
      }
    },
    "Turn on focus mode": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
