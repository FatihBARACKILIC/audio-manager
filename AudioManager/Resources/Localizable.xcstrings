    },
    "This window runs past midnight into the next day.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aralık gece yarısını aşıp ertesi güne uzanıyor."
          }
        }
      }
    },
    "A rule that starts and ends at the same time never runs.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıcı ve bitişi aynı olan bir kural hiçbir zaman çalışmaz."
          }
        }
      }
    },
    "When": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman"
