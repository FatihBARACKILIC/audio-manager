    "None": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yok"
          }
        }
      }
    },
    "Mute only silences this app at the source. No processing, no added delay.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sessize al, bu uygulamayı kaynağında susturur. İşleme yok, ek gecikme yok."
          }
        }
      }
    },
    "Full control routes this app through Audio Manager so volume, boost and EQ work. Adds a few milliseconds of delay — fine for music and video, less ideal for calls.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam kontrol, bu uygulamayı Audio Manager üzerinden geçirir; böylece ses seviyesi, güçlendirme ve ekolayzer çalışır. Birkaç milisaniye gecikme ekler — müzik ve video için sorunsuz, görüşmeler için daha az uygun."
          }
        }
      }
    },
    "%@ muted": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sessize alındı"
