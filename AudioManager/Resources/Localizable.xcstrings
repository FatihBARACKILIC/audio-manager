    "Change any app in the panel, then press Update to fold those changes into this profile.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelden istediğin uygulamayı değiştir, sonra Güncelle'ye basarak bu değişiklikleri profile işle."
          }
        }
      }
    },
