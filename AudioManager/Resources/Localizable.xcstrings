    "Allow in focus mode": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak modunda izin ver"
          }
        }
      }
    },
    "Applied after volume, boost and EQ, so nothing can get past it. Values above 100% let quiet apps be amplified; keep it at or below 100% to protect your hearing.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, güçlendirme ve ekolayzerden sonra uygulanır; hiçbir şey bunu aşamaz. %100 üzerindeki değerler kısık uygulamaların yükseltilmesine izin verir; işitme sağlığın için %100 veya altında tut."
          }
        }
      }
    },
    "Apps allowed in focus mode": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak modunda izin verilen uygulamalar"
          }
        }
      }
    },
    "Apps appear here as soon as they are running.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar çalışmaya başlar başlamaz burada görünür."
          }
        }
      }
    },
