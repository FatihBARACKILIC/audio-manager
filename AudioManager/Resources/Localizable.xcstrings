    "No apps with audio yet": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sesi olan uygulama yok"
          }
        }
      }
    },
    "Apps appear here as soon as they are running.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar çalışmaya başlar başlamaz burada görünür."
          }
        }
      }
    },
    "No profile": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil yok"
          }
        }
      }
    },
    "Quit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çık"
          }
        }
      }
    },
    "Audio Manager needs permission to capture system audio.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Manager'ın sistem sesini yakalama izni gerekiyor."
          }
        }
      }
    },
    "One app could not be controlled and was left untouched.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama kontrol edilemedi ve olduğu gibi bırakıldı."
          }
        }
      }
    },
    "The output device changed. Audio is playing normally.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış aygıtı değişti. Ses normal şekilde çalıyor."
          }
        }
      }
    },
    "This app plays protected content that cannot be controlled.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, kontrol edilemeyen korumalı içerik çalıyor."
          }
        }
      }
    },
    "This app's audio format is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın ses biçimi desteklenmiyor."
          }
        }
      }
    },
    "Permission needed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin gerekiyor"
          }
        }
      }
    },
    "macOS treats controlling another app's volume as capturing its audio. Audio Manager never records or stores anything.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, başka bir uygulamanın sesini kontrol etmeyi o sesi yakalamak olarak görür. Audio Manager hiçbir şeyi kaydetmez ya da saklamaz."
          }
        }
      }
    },
    "Grant access": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin ver"
          }
        }
      }
    },
    "Open System Settings": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nı aç"
          }
        }
      }
    },
    "Active profile": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
